// Flock — data model
// Multi-tenant: every domain row scopes to a Hall via hallId.
// Roles: ADMIN (RS) -> LEADER (CGL) -> MEMBER (Student).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Supabase pooled vs. direct connection (used by migrations)
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN // Resident Shepherd
  LEADER // Community Group Leader
  MEMBER // Student
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum CareNoteTag {
  PRAYER
  FOLLOW_UP
  POSSIBLE_IR
}

enum VerseAudience {
  LEADERS // RS -> the hall's CGLs
  GROUP // CGL -> their group's members
}

/// A hall (~70 men). The tenant boundary — no cross-hall visibility.
model Hall {
  id        String   @id @default(cuid())
  name      String // e.g. "Hall 3"
  // Secret code an RS shares so his guys bind to THIS hall at signup. Rotatable.
  joinCode  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  groups           Group[]
  weeks            Week[]
  attendance       AttendanceRecord[]
  careNotes        CareNote[]
  resources        Resource[]
  memoryVerses     MemoryVerse[]
}

/// A person on the hall. `id` mirrors the Supabase auth user id.
model User {
  id        String   @id // = Supabase auth uid
  email     String   @unique // must end in @liberty.edu
  username  String
  role      Role     @default(MEMBER)
  // False disables access without deleting history (e.g. end-of-year, removed).
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Null = PENDING: signed up but not yet bound to a hall. Sees nothing until bound.
  hall   Hall?   @relation(fields: [hallId], references: [id])
  hallId String?

  // The community group this student belongs to (MEMBER). Null for unassigned.
  group   Group?  @relation("GroupMembers", fields: [groupId], references: [id])
  groupId String?

  // Groups this user leads (LEADER). Usually one.
  ledGroups Group[] @relation("GroupLeader")

  // Personal weekly passage notes.
  weeklyNotes WeeklyNote[]

  // Care notes: as the subject (guy) and as the author (CGL).
  careNotesAbout   CareNote[] @relation("CareNoteStudent")
  careNotesWritten CareNote[] @relation("CareNoteAuthor")

  // Attendance records: as the subject, the recorder, and the confirmer (CGL).
  attendance          AttendanceRecord[] @relation("AttendanceStudent")
  attendanceRecorded  AttendanceRecord[] @relation("AttendanceRecorder")
  attendanceConfirmed AttendanceRecord[] @relation("AttendanceConfirmer")

  // Memory verses this user assigned (RS -> CGLs, or CGL -> their group).
  versesAuthored MemoryVerse[] @relation("VerseAuthor")

  @@index([hallId])
  @@index([groupId])
}

/// A community group (~7 men) led by one CGL.
model Group {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hall   Hall   @relation(fields: [hallId], references: [id])
  hallId String

  leader   User?   @relation("GroupLeader", fields: [leaderId], references: [id])
  leaderId String?

  members      User[]             @relation("GroupMembers")
  attendance   AttendanceRecord[]
  memoryVerses MemoryVerse[]

  @@index([hallId])
}

/// A Wednesday: the set study passage for the whole hall.
model Week {
  id          String   @id @default(cuid())
  index       Int // 1, 2, 3 ... within a semester
  date        DateTime // the Wednesday
  semester    String // e.g. "Fall 2026"
  passageRef  String // e.g. "John 15:1-11"
  enduringUrl String? // link to Enduring Word for these verses
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hall   Hall   @relation(fields: [hallId], references: [id])
  hallId String

  weeklyNotes WeeklyNote[]
  attendance  AttendanceRecord[]

  @@unique([hallId, index, semester])
  @@index([hallId])
}

/// A verse to memorize. Two tiers:
///   LEADERS — the RS assigns it to the hall's CGLs.
///   GROUP   — a CGL assigns it to their own group's members.
/// Plain reference + text — never interpreted.
model MemoryVerse {
  id        String        @id @default(cuid())
  reference String // "John 15:5"
  text      String // the verse text (human-entered, no commentary)
  audience  VerseAudience
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  hall   Hall   @relation(fields: [hallId], references: [id])
  hallId String

  // Set only for GROUP-audience verses (which group they're for).
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String?

  author   User?   @relation("VerseAuthor", fields: [authorId], references: [id])
  authorId String?

  @@index([hallId])
  @@index([groupId])
  @@index([audience])
}

/// Private, per-person notes on the week's passage. A blank study journal.
model WeeklyNote {
  id        String   @id @default(cuid())
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  week   Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  weekId String

  @@unique([authorId, weekId])
  @@index([weekId])
}

/// One Wednesday's attendance for one student. The CGL's confirm is the record
/// of truth; a student may self-check-in first (selfReportedAt) to pre-fill it.
model AttendanceRecord {
  id        String           @id @default(cuid())
  status    AttendanceStatus @default(ABSENT)
  // Student tapped "I'm here" (pre-fill hint for the CGL). Null = didn't self-report.
  selfReportedAt DateTime?
  // Set when the CGL confirms the roster — this is what makes the record official.
  confirmedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  hall   Hall   @relation(fields: [hallId], references: [id])
  hallId String

  week   Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  weekId String

  student   User   @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  // Snapshot of the group at record time (groups can change via the draft).
  group   Group?  @relation(fields: [groupId], references: [id])
  groupId String?

  // Who last set the record, and who confirmed it (the CGL).
  recordedBy   User?   @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  recordedById String?
  confirmedBy   User?  @relation("AttendanceConfirmer", fields: [confirmedById], references: [id])
  confirmedById String?

  @@unique([weekId, studentId])
  @@index([hallId])
  @@index([weekId])
  @@index([groupId])
}

/// A dated note a CGL logs on one of their guys. Accumulates all semester.
model CareNote {
  id           String       @id @default(cuid())
  body         String
  tag          CareNoteTag?
  possibleIR   Boolean      @default(false)
  semester     String // grouping window for spiritual summaries
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  hall   Hall   @relation(fields: [hallId], references: [id])
  hallId String

  student   User   @relation("CareNoteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  author   User?   @relation("CareNoteAuthor", fields: [authorId], references: [id])
  authorId String?

  @@index([hallId])
  @@index([studentId])
  @@index([semester])
}

/// RS-editable link the hall always needs (Enduring Word, sign-out form, portals).
model Resource {
  id        String   @id @default(cuid())
  label     String
  url       String
  pinned    Boolean  @default(false) // pin to Home
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hall   Hall   @relation(fields: [hallId], references: [id])
  hallId String

  @@index([hallId])
}
